# Copy to `.env.local` for local dev. Never commit real keys.
# On Vercel: Settings → Environment Variables → `NVIDIA_API_KEY` (and redeploy).
NVIDIA_API_KEY=

# Public site URL (no secret). Use your production domain so Open Graph / LinkedIn previews resolve images correctly.
# Example: https://flex-o-matic.vercel.app or your custom domain
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_API_ALLOWED_HOST_SUFFIXES=nvidia.com
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
